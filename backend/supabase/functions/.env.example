# Secrets for the Edge Functions. Set them on the hosted project with:
#   supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided automatically on Supabase.

# The portal's address, for invite and email links. Live: https://unir.developers-a4a.workers.dev
SITE_URL=http://localhost:5173
# Lock CORS to the portal's address in production (defaults to *), e.g. https://unir.developers-a4a.workers.dev
ALLOWED_ORIGIN=

# Email (Resend → API Keys, and Resend → Webhooks for the signing secret).
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Chat and Agents (Claude). MGC's key for now; per-firm keys can come later.
ANTHROPIC_API_KEY=
# Optional: override the model behind each agent speed.
MODEL_FAST=claude-haiku-5-5
MODEL_BALANCED=claude-sonnet-5-5
MODEL_ADVANCED=claude-opus-5-5
# true: Chat needs the "chat" add-on on the firm, Agents the "agents" add-on (firms.addons).
REQUIRE_ADDONS=false

# Gmail (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, type "Web application").
# Authorised redirect URI: https://<project-ref>.supabase.co/functions/v1/google-oauth
# Enable the Gmail API, and add the gmail.readonly and gmail.send scopes on the OAuth consent screen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any long random string: signs the OAuth state so the callback knows which firm started it (openssl rand -hex 32).
GOOGLE_OAUTH_STATE_SECRET=
# Optional: only if the redirect URI differs from the default above.
GOOGLE_REDIRECT_URI=
