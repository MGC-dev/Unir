# Copy this file to .env.local and fill in your Supabase project's values
# (Supabase dashboard → Project Settings → API). Restart `npm run dev` after changing it.
# Leave them empty to run the portal in demo mode, with no real accounts.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Set to true to let people create their own accounts. Leave it off while the team onboards clients by invite.
VITE_ALLOW_SIGNUP=false
